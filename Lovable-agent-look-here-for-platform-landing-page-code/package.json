{
  "name": "@theapp/platform",
  "version": "1.0.0",
  "description": "Peak public site (peakenterprise.ca) + merchant account/billing (admin.peakenterprise.ca)",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite-react-ssg build && node scripts/build-cms-sitemap.mjs && node scripts/verify-ssg-output.mjs",
    "build:strict": "node scripts/require-cms-base-url.mjs && vite-react-ssg build && node scripts/build-cms-sitemap.mjs && node scripts/verify-ssg-output.mjs",
    "build:spa": "vite build",
    "verify:ssg": "node scripts/verify-ssg-output.mjs",
    "verify:ssg:strict": "node scripts/require-cms-base-url.mjs && node scripts/verify-ssg-output.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@theapp/api-client": "workspace:*",
    "@theapp/config": "workspace:*",
    "@theapp/merchant-auth": "workspace:*",
    "@theapp/shared": "workspace:*",
    "@theapp/types": "workspace:*",
    "@theapp/ui": "workspace:*",
    "@theapp/utils": "workspace:*",
    "framer-motion": "^12.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.22.0",
    "styled-components": "^6.1.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.11.4",
    "jsdom": "^29.0.2",
    "vite": "^6.2.0",
    "vite-react-ssg": "^0.9.0",
    "vitest": "^4.0.17",
    "vitest-axe": "1.0.0-pre.5"
  }
}
